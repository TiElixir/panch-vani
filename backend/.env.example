# ─── Google OAuth 2.0 ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# The URL Google will redirect to after the user authenticates
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
# Frontend URL (used for redirecting after OAuth with token)
FRONTEND_URL=http://localhost:5173

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-hex-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (dev default):
DATABASE_URL=sqlite:///./panch_vani.db
# PostgreSQL (prod example):
# DATABASE_URL=postgresql://user:password@localhost/panch_vani

# ─── Platform Super Admins ────────────────────────────────────────────────────
# Comma-separated list of Google-verified emails that become super admins on first login
SUPER_ADMIN_EMAILS=you@example.com
